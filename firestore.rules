rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    // Signed in with a real, verified account (not "Continue as guest",
    // and the email link has been clicked).
    function isRealUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true
        && !isTemporaryEmail();
    }
    // Temporary inbox services (keep in sync with lib/models/blocked_domains.dart).
    function isTemporaryEmail() {
      return request.auth.token.email.lower().split('@')[1] in [
        '10minutemail.com', '10minutemail.net', '1secmail.com', '1secmail.net',
        'burnermail.io', 'discard.email', 'dispostable.com', 'emailfake.com',
        'emailondeck.com', 'fakeinbox.com', 'getnada.com', 'grr.la',
        'guerrillamail.com', 'guerrillamail.net', 'guerrillamail.org',
        'inboxkitten.com', 'mail.tm', 'mailcatch.com', 'maildrop.cc',
        'mailinator.com', 'mailnesia.com', 'mintemail.com', 'moakt.com',
        'mohmal.com', 'nada.email', 'sharklasers.com', 'spamgourmet.com',
        'temp-mail.io', 'temp-mail.org', 'tempinbox.com', 'tempmail.com',
        'tempmail.net', 'tempmailo.com', 'tempr.email', 'throwawaymail.com',
        'tmpmail.org', 'trashmail.com', 'yopmail.com', 'yopmail.net'
      ];
    }
    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Admins are listed in admins/{uid} (added by hand in the console).
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isMemberOf(hubId) {
      return exists(/databases/$(database)/documents/hubs/$(hubId)/members/$(request.auth.uid));
    }

    // ---------- reports ----------
    // Only admins can read reports. Members can file one report per piece
    // of content (the id includes their uid, and reports can't be
    // overwritten).
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isRealUser()
        && reportId.matches('.*_' + request.auth.uid)
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['type', 'path', 'hubId', 'hubName', 'postId', 'preview',
              'authorName', 'reason', 'details', 'reportedBy', 'status',
              'createdAt'])
        && request.resource.data.type in ['post', 'comment', 'message']
        && request.resource.data.reason in
             ['harassment', 'substances', 'selfHarm', 'spam', 'other']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.preview is string
        && request.resource.data.preview.size() <= 500
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 300
        && isMemberOf(request.resource.data.hubId);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['removed', 'dismissed'];
      allow delete: if false;
    }

    // ---------- admins ----------
    // You can check whether you yourself are an admin; nobody can edit this
    // from the app.
    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    // ---------- hub suggestions ----------
    match /hubRequests/{requestId} {
      // Only the person who asked, and admins, can see a request.
      allow read: if isRealUser()
        && (resource.data.requestedBy == request.auth.uid || isAdmin());

      allow create: if isRealUser()
        && request.resource.data.keys().hasOnly(
             ['name', 'interest', 'online', 'description', 'requestedBy',
              'requesterName', 'status', 'createdAt'])
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 20
        && request.resource.data.description.size() <= 300
        && request.resource.data.interest in
             ['riding', 'gaming', 'sports', 'hiking', 'art', 'cooking',
              'music', 'reading']
        && request.resource.data.online is bool
        && request.resource.data.requesterName is string;

      // Admins approve or decline.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewNote', 'hubId', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected'];

      // The requester can withdraw while it's still pending.
      allow delete: if isRealUser()
        && resource.data.requestedBy == request.auth.uid
        && resource.data.status == 'pending';
    }

    // ---------- users ----------
    // Your profile: only you can read or change it.
    match /users/{uid} {
      allow read, write: if isMe(uid);
      // Admins may only add a hub to someone's joined list (when approving
      // the hub they suggested). Nothing else on the profile.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedHubs']);

      // Daily check-ins are private: only you, and never guests.
      match /checkins/{day} {
        allow read, write: if isMe(uid) && isRealUser();
      }
      // Private list of posts you wrote (keeps anonymous posts anonymous).
      match /posts/{postId} {
        allow read, write: if isMe(uid) && isRealUser();
      }
      // Private list of comments you wrote.
      match /comments/{commentId} {
        allow read, write: if isMe(uid) && isRealUser();
      }
      // Your RSVPs (private copy, used for goal milestones).
      match /rsvps/{eventId} {
        allow read, write: if isMe(uid) && isRealUser();
      }
      // Private notes like your recovery plan. Only you, ever.
      match /private/{docId} {
        allow read, write: if isMe(uid) && isRealUser();
      }
      // When you last opened each hub chat (for unread dots).
      match /chatReads/{hubId} {
        allow read, write: if isMe(uid) && isRealUser();
      }
      // Private list of your reactions.
      match /reactions/{postId} {
        allow read, write: if isMe(uid) && isRealUser();
      }
    }

    // ---------- hubs ----------
    match /hubs/{hubId} {
      function memberPath() {
        return /databases/$(database)/documents/hubs/$(hubId)/members/$(request.auth.uid);
      }

      // Anyone signed in (including guests) can browse hubs.
      allow read: if signedIn();

      // Only admins create hubs (by approving a suggestion), and only
      // suggested hubs can be deleted. The starter hubs are protected.
      allow create: if isAdmin();
      allow delete: if isAdmin() && resource.data.get('requestId', null) != null;

      // Members may only change the member count: +1 when they join (their
      // member doc appears) or -1 when they leave (it disappears). A leader
      // who leaves also clears the leader fields in the same write.
      allow update: if isAdmin() || isRealUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
        && (
          (request.resource.data.memberCount == resource.data.memberCount + 1
            && !exists(memberPath()) && existsAfter(memberPath()))
          ||
          (request.resource.data.memberCount == resource.data.memberCount - 1
            && exists(memberPath()) && !existsAfter(memberPath()))
        )
        || isRealUser()
        && resource.data.get('leaderId', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberCount', 'leaderId', 'leaderName', 'founderName'])
        && !('leaderId' in request.resource.data)
        && !('leaderName' in request.resource.data)
        && request.resource.data.get('founderName', '') in
             [resource.data.get('founderName', ''), resource.data.get('leaderName', '')]
        && request.resource.data.memberCount == resource.data.memberCount - 1
        && exists(memberPath()) && !existsAfter(memberPath());

      // Group chat: members only. Messages can't be edited; only the
      // sender can delete their own.
      match /messages/{messageId} {
        allow read: if isAdmin() || (isRealUser() && exists(memberPath()));
        allow create: if isRealUser()
          && exists(memberPath())
          && request.resource.data.keys().hasOnly(
               ['senderId', 'senderName', 'body', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow delete: if isAdmin() || (isRealUser()
          && resource.data.senderId == request.auth.uid);
        allow update: if false;
      }

      // ---------- activities ----------
      match /events/{eventId} {
        // Hub leader (whoever suggested the hub) or an admin.
        function canManage() {
          return isAdmin() || (isRealUser()
            && get(/databases/$(database)/documents/hubs/$(hubId)).data.get('leaderId', '') == request.auth.uid);
        }
        function goingPath() {
          return /databases/$(database)/documents/hubs/$(hubId)/events/$(eventId)/going/$(request.auth.uid);
        }

        // Meetup details are for members only.
        allow read: if isAdmin() || (isRealUser() && exists(memberPath()));

        allow create: if canManage()
          && request.resource.data.keys().hasOnly(
               ['title', 'startsAt', 'place', 'details', 'createdBy',
                'createdByName', 'goingCount', 'createdAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 60
          && request.resource.data.place is string
          && request.resource.data.place.size() <= 100
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 500
          && request.resource.data.startsAt is timestamp
          && request.resource.data.startsAt > request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.goingCount == 0
          && request.resource.data.createdAt == request.time;

        allow delete: if canManage();

        // RSVP count: +1 / -1 only, matching your own RSVP doc.
        allow update: if isAdmin() || (isRealUser()
          && exists(memberPath())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['goingCount'])
          && (
            (request.resource.data.goingCount == resource.data.goingCount + 1
              && !exists(goingPath()) && existsAfter(goingPath()))
            ||
            (request.resource.data.goingCount == resource.data.goingCount - 1
              && exists(goingPath()) && !existsAfter(goingPath()))
          ));

        match /going/{uid} {
          allow read: if isMe(uid);
          allow create: if isMe(uid) && isRealUser() && exists(memberPath());
          allow delete: if isMe(uid);
          allow update: if false;
        }
      }

      // Membership: you can only add/remove (and read) yourself.
      match /members/{uid} {
        // You can see your own membership; admins see the list to pick
        // a hub leader.
        allow read: if isMe(uid) || isAdmin();
        // You add yourself; admins add a hub's leader when approving it.
        allow create: if (isMe(uid) && isRealUser()) || isAdmin();
        allow delete: if isMe(uid) || isAdmin();
        allow update: if false;
      }
    }

    // ---------- posts ----------
    match /posts/{postId} {
      function myMarker() {
        return /databases/$(database)/documents/users/$(request.auth.uid)/posts/$(postId);
      }
      function okDelta(k) {
        let before = resource.data.reactions.get(k, 0);
        let after = request.resource.data.reactions.get(k, 0);
        return after >= 0 && after - before >= -1 && after - before <= 1;
      }
      function okCommentDelta() {
        let before = resource.data.get('commentCount', 0);
        let after = request.resource.data.commentCount;
        return after >= 0 && after - before >= -1 && after - before <= 1;
      }

      function isHubMember(hubId) {
        return exists(/databases/$(database)/documents/hubs/$(hubId)/members/$(request.auth.uid));
      }

      // Posts are private to their hub: only members can read them.
      allow read: if isAdmin()
        || (isRealUser() && isHubMember(resource.data.hubId));

      // Post to a hub you're a member of. No author id is stored.
      allow create: if isRealUser()
        && existsAfter(myMarker())
        && exists(/databases/$(database)/documents/hubs/$(request.resource.data.hubId)/members/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(
             ['hubId', 'hubName', 'authorName', 'anonymous', 'body', 'createdAt',
              'reactions', 'commentCount'])
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.reactions == {'support': 0, 'proud': 0, 'relate': 0}
        && request.resource.data.commentCount == 0
        && (
          (request.resource.data.anonymous == true
            && request.resource.data.authorName == null)
          ||
          (request.resource.data.anonymous == false
            && request.resource.data.authorName is string)
        );

      // Reactions or comment count: may only move by one at a time.
      // ('encourage' only exists on older posts.)
      allow update: if isAdmin() || isRealUser() && isHubMember(resource.data.hubId) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions.keys().hasOnly(
               ['support', 'proud', 'relate', 'encourage'])
          && okDelta('support') && okDelta('proud')
          && okDelta('relate') && okDelta('encourage'))
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
          && okCommentDelta())
      );

      // Only the author can delete (checked via their private marker).
      allow delete: if isAdmin() || (isRealUser() && exists(myMarker()));

      // ---------- comments ----------
      match /comments/{commentId} {
        function myCommentMarker() {
          return /databases/$(database)/documents/users/$(request.auth.uid)/comments/$(commentId);
        }
        function postHub() {
          return get(/databases/$(database)/documents/posts/$(postId)).data.hubId;
        }

        // Comments are private to the post's hub, like the post itself.
        allow read: if isAdmin() || (isRealUser()
          && exists(/databases/$(database)/documents/hubs/$(postHub())/members/$(request.auth.uid)));

        // Only members of the post's hub can comment. No author id stored.
        allow create: if isRealUser()
          && existsAfter(myCommentMarker())
          && exists(/databases/$(database)/documents/hubs/$(postHub())/members/$(request.auth.uid))
          && request.resource.data.keys().hasOnly(
               ['authorName', 'anonymous', 'body', 'createdAt'])
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 500
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.anonymous == true
              && request.resource.data.authorName == null)
            ||
            (request.resource.data.anonymous == false
              && request.resource.data.authorName is string)
          );

        allow delete: if isAdmin()
          || (isRealUser() && exists(myCommentMarker()));
        allow update: if false;
      }
    }
  }
}
